---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NarrativeDisplay from '../../../components/NarrativeDisplay.astro';
import StoryCard from '../../../components/StoryCard.astro';
import { chapters, getChapter, getStory } from '../../../lib/narratives';

export async function getStaticPaths() {
  return chapters.flatMap((chapter) =>
    chapter.stories.map((story) => ({
      params: { chapter: chapter.id, story: story.id },
    }))
  );
}

const { chapter: chapterId, story: storyId } = Astro.params;

const chapter = getChapter(chapterId);
const story = getStory(chapterId, storyId);

if (!chapter || !story) {
  return Astro.redirect('/404');
}

const title = `${story.title} - ${chapter.title} | The Scroll of Dharma`;
---

<BaseLayout title={title} description={story.content.substring(0, 150) + '...'}>
  <!-- Breadcrumb -->
  <nav class="mb-6 text-sm text-amber-700">
    <a href={import.meta.env.BASE_URL} class="hover:text-amber-900 transition-colors">Home</a>
    <span class="mx-2">→</span>
    <span class="text-amber-900 font-semibold">{chapter.title}</span>
    <span class="mx-2">→</span>
    <span class="text-amber-900 font-semibold">{story.title}</span>
  </nav>

  <!-- Chapter Title -->
  <div class="text-center mb-8">
    <h1 class="text-3xl md:text-4xl font-heading font-bold text-amber-900 mb-2">
      {chapter.title}
    </h1>
    <h2 class="text-2xl md:text-3xl font-body text-amber-800">
      {story.title}
    </h2>
  </div>

  <!-- Story Navigation -->
  <section class="mb-12">
    <h3 class="text-xl font-heading font-bold text-amber-900 mb-4">
      Stories in this Chapter
    </h3>
    <div class="grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
      {chapter.stories.map((s) => (
        <StoryCard story={s} chapterId={chapter.id} active={s.id === story.id} />
      ))}
    </div>
  </section>

  <!-- Main Story Content -->
  <NarrativeDisplay story={story} />

  <!-- Navigation -->
  <nav class="mt-12 flex justify-between items-center">
    {(() => {
      const currentIndex = chapter.stories.findIndex(s => s.id === story.id);
      const prevStory = currentIndex > 0 ? chapter.stories[currentIndex - 1] : null;
      const nextStory = currentIndex < chapter.stories.length - 1 ? chapter.stories[currentIndex + 1] : null;
      
      return (
        <>
          <div class="flex-1">
            {prevStory && (
              <a
                href={`${import.meta.env.BASE_URL}/chapters/${chapter.id}/${prevStory.id}`}
                class="inline-flex items-center px-4 py-2 bg-amber-100 hover:bg-amber-200 border border-amber-700/40 rounded-lg text-amber-900 transition-colors"
              >
                ← {prevStory.title}
              </a>
            )}
          </div>
          
          <a
            href={import.meta.env.BASE_URL}
            class="px-4 py-2 bg-amber-100 hover:bg-amber-200 border border-amber-700/40 rounded-lg text-amber-900 transition-colors"
          >
            All Chapters
          </a>
          
          <div class="flex-1 text-right">
            {nextStory && (
              <a
                href={`${import.meta.env.BASE_URL}/chapters/${chapter.id}/${nextStory.id}`}
                class="inline-flex items-center px-4 py-2 bg-amber-100 hover:bg-amber-200 border border-amber-700/40 rounded-lg text-amber-900 transition-colors"
              >
                {nextStory.title} →
              </a>
            )}
          </div>
        </>
      );
    })()}
  </nav>
</BaseLayout>

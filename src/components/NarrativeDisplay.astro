---
import type { Story } from '../lib/types';
import AudioPlayer from './AudioPlayer.astro';

interface Props {
  story: Story;
}

const { story } = Astro.props;
const svgPath = `${import.meta.env.BASE_URL}/assets/svg/${story.svgFile || 'lotus.svg'}`;
---

<article class="max-w-5xl mx-auto">
  <div class="grid md:grid-cols-2 gap-8 items-start">
    <!-- SVG Illustration -->
    <div class="flex justify-center items-center">
      <div class={`w-full max-w-md ${story.animationClass || ''}`}>
        <img
          src={svgPath}
          alt={story.alt || story.title}
          class="w-full h-auto"
          loading="eager"
        />
      </div>
    </div>

    <!-- Narrative Content -->
    <div class="space-y-6">
      <section>
        <h2 class="text-2xl font-heading font-bold text-amber-900 mb-4">
          Meditation
        </h2>
        <blockquote class="meditation-highlight">
          {story.content}
        </blockquote>
      </section>

      <!-- Sanskrit Chant -->
      {story.chantLines && story.chantLines.length > 0 && (
        <section>
          <h2 class="text-2xl font-heading font-bold text-amber-900 mb-4">
            Sacred Chant
          </h2>
          <div class="bg-amber-50/80 backdrop-blur-sm border-2 border-amber-700/30 rounded-lg p-6 space-y-2">
            {story.chantLines.map((line) => (
              <p class="text-center text-lg font-spectral text-amber-900 italic leading-relaxed">
                {line}
              </p>
            ))}
          </div>
        </section>
      )}

      <!-- Audio Player -->
      <section>
        <AudioPlayer 
          narrative={story.audio?.narrative} 
          ambient={story.audio?.ambient} 
        />
      </section>
    </div>
  </div>

  <!-- Story Artwork (if available) -->
  {story.artworkFile && (
    <div class="mt-12">
      <h2 class="text-2xl font-heading font-bold text-amber-900 mb-6 text-center">
        Visual Meditation
      </h2>
      <div class="flex justify-center">
        <div class="max-w-3xl w-full">
          <img
            src={`${import.meta.env.BASE_URL}/assets/artworks/${story.artworkFile}`}
            alt={`Artwork for ${story.title}`}
            class="w-full h-auto rounded-lg shadow-2xl border-4 border-amber-700/40"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  )}
</article>
